    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "pdfmake": "^0.3.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
